{
  "name": "@streamsidekick/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run build --workspace @streamsidekick/shared",
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm run build --workspace @streamsidekick/shared",
    "build": "tsc -p tsconfig.json",
    "precheck": "npm run check --workspace @streamsidekick/shared",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@streamsidekick/shared": "0.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "openai": "^6.37.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^24.0.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
